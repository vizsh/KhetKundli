    "d3-polygon": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^12.43.0",
    "next": "16.4.2",
    "onnxruntime-web": "^1.30.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
